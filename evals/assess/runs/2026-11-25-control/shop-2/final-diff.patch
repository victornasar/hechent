--- a/test/shop.test.js
+++ b/test/shop.test.js
@@ -4,3 +4,19 @@ const { refundLine } = require('../src/refund');
 const order = { lines: [{ sku: 'a', unitCents: 1000, qty: 2 }, { sku: 'b', unitCents: 500, qty: 1 }] };
 test('invoice totals reconcile', () => { const i = invoice(order); assert.strictEqual(i.totalCents, i.subtotalCents + i.taxCents); assert.strictEqual(i.totalCents, 3000); });
 test('refund includes VAT on the line', () => assert.strictEqual(refundLine(order, 0, 1), 1200));
+const discounted = { ...order, discountCents: 500 };
+test('discount reduces taxable amount and invoice reconciles', () => {
+  const i = invoice(discounted);
+  assert.strictEqual(i.discountCents, 500); assert.strictEqual(i.taxCents, 400);
+  assert.strictEqual(i.totalCents, i.subtotalCents - i.discountCents + i.taxCents); assert.strictEqual(i.totalCents, 2400);
+});
+test('no discount behaves as before', () => assert.strictEqual(invoice(order).discountCents, 0));
+test('refund deducts the line\'s pro-rata share of the discount', () => assert.strictEqual(refundLine(discounted, 0, 1), 960));
+test('refunding everything returns what was paid', () => {
+  const total = refundLine(discounted, 0, 2) + refundLine(discounted, 1, 1);
+  assert.strictEqual(total, invoice(discounted).totalCents);
+});
+test('invalid discounts are rejected', () => {
+  assert.throws(() => invoice({ ...order, discountCents: -1 }));
+  assert.throws(() => invoice({ ...order, discountCents: 2501 }));
+});
