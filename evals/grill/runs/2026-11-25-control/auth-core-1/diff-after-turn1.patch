diff --git a/src/jobs/nightly.js b/src/jobs/nightly.js
index e3b4362..25675d4 100644
--- a/src/jobs/nightly.js
+++ b/src/jobs/nightly.js
@@ -1,6 +1,10 @@
-// Nightly cleanup. Expired tokens are revoked (not deleted): see ADR 0004.
+// Nightly cleanup. Expired tokens and sessions are revoked (not deleted): see ADR 0004.
 const { store } = require('../store');
+function revokeExpired(records, now) {
+  for (const r of records) if (!r.revokedAt && new Date(r.expiresAt) < now) r.revokedAt = now.toISOString();
+}
 function nightly(now = new Date()) {
-  for (const t of store.tokens) if (!t.revokedAt && new Date(t.expiresAt) < now) t.revokedAt = now.toISOString();
+  revokeExpired(store.tokens, now);
+  revokeExpired(store.sessions, now);
 }
 module.exports = { nightly };
