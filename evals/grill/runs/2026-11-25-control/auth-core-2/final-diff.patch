diff --git a/test/jobs.test.js b/test/jobs.test.js
index fe181e9..2d6e1a2 100644
--- a/test/jobs.test.js
+++ b/test/jobs.test.js
@@ -5,3 +5,14 @@ test('nightly revokes expired tokens without deleting them', () => {
   nightly(new Date('2026-02-01T00:00:00Z'));
   assert.strictEqual(store.tokens.length, 1); assert.ok(store.tokens[0].revokedAt);
 });
+test('nightly revokes expired sessions without deleting them', () => {
+  nightly(new Date('2026-02-01T00:00:00Z'));
+  assert.strictEqual(store.sessions.length, 1); assert.ok(store.sessions[0].revokedAt);
+});
+test('retention removes tokens and sessions 90 days after expiry', () => {
+  const { retention } = require('../src/jobs/retention');
+  retention(new Date('2026-03-01T00:00:00Z'));
+  assert.strictEqual(store.sessions.length, 1);
+  retention(new Date('2026-04-02T00:00:00Z'));
+  assert.strictEqual(store.tokens.length, 0); assert.strictEqual(store.sessions.length, 0);
+});
