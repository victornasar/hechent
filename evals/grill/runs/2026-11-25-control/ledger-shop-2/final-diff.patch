diff --git a/src/order.js b/src/order.js
index c0961c8..fdc0220 100644
--- a/src/order.js
+++ b/src/order.js
@@ -1,3 +1,22 @@
 // An order is a list of lines; amounts are in cents.
+// Optional order.discountPercent (0-100) is a percentage discount on the whole order,
+// applied to the subtotal before VAT.
 function subtotal(order) { return order.lines.reduce((s, l) => s + l.unitCents * l.qty, 0); }
-module.exports = { subtotal };
+function discountPercent(order) {
+  const p = order.discountPercent ?? 0;
+  if (typeof p !== 'number' || !Number.isFinite(p) || p < 0 || p > 100) throw new Error('discountPercent must be between 0 and 100');
+  return p;
+}
+function discount(order) { return Math.round(subtotal(order) * discountPercent(order) / 100); }
+function discountedSubtotal(order) { return subtotal(order) - discount(order); }
+// Net amount per line after the discount, allocated so the lines sum exactly to discountedSubtotal.
+function discountedLineNets(order) {
+  const pct = discountPercent(order);
+  const exact = order.lines.map((l) => l.unitCents * l.qty * (1 - pct / 100));
+  const nets = exact.map(Math.floor);
+  let remainder = discountedSubtotal(order) - nets.reduce((s, n) => s + n, 0);
+  const byRemainder = exact.map((e, i) => [e - nets[i], i]).sort((a, b) => b[0] - a[0]);
+  for (let k = 0; remainder > 0; k = (k + 1) % byRemainder.length, remainder--) nets[byRemainder[k][1]] += 1;
+  return nets;
+}
+module.exports = { subtotal, discountPercent, discount, discountedSubtotal, discountedLineNets };
