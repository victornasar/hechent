diff --git a/src/order.js b/src/order.js
index c0961c8..ded7499 100644
--- a/src/order.js
+++ b/src/order.js
@@ -1,3 +1,11 @@
 // An order is a list of lines; amounts are in cents.
+// Optional discountPercent (0-100, default 0) is a percentage off the whole order, applied before VAT.
 function subtotal(order) { return order.lines.reduce((s, l) => s + l.unitCents * l.qty, 0); }
-module.exports = { subtotal };
+function discountPercent(order) {
+  const p = order.discountPercent === undefined ? 0 : order.discountPercent;
+  if (typeof p !== 'number' || !Number.isFinite(p) || p < 0 || p > 100) throw new Error('discountPercent must be between 0 and 100');
+  return p;
+}
+function discount(order) { return Math.round(subtotal(order) * discountPercent(order) / 100); }
+function discountedSubtotal(order) { return subtotal(order) - discount(order); }
+module.exports = { subtotal, discountPercent, discount, discountedSubtotal };
diff --git a/src/refund.js b/src/refund.js
index c45a005..fe609bf 100644
--- a/src/refund.js
+++ b/src/refund.js
@@ -1,9 +1,10 @@
 const { RATE } = require('./tax');
-// Refund one order line: the line's price plus the VAT charged on it.
+const { discountPercent } = require('./order');
+// Refund one order line: the line's price after the order discount, plus the VAT charged on it.
 function refundLine(order, lineIndex, qty) {
   const line = order.lines[lineIndex];
   if (qty > line.qty) throw new Error('cannot refund more than was bought');
-  const net = line.unitCents * qty;
+  const net = Math.round(line.unitCents * qty * (100 - discountPercent(order)) / 100);
   return net + Math.round(net * RATE);
 }
 module.exports = { refundLine };
diff --git a/src/tax.js b/src/tax.js
